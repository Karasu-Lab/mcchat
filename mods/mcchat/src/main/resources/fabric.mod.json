{
	"schemaVersion": 1,
	"id": "chatnative",
	"version": "${version}",
	"name": "ChatNative",
	"description": "Captures chat, command and player events and syncs them to external apps over TCP.",
	"authors": [
		"Karasu-Lab"
	],
	"contact": {
		"homepage": "https://github.com/Karasu-Lab/mcchat",
		"sources": "https://github.com/Karasu-Lab/mcchat"
	},
	"license": "CC0-1.0",
	"icon": "assets/chatnative/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.karasu256.ChatNative"
		],
		"client": [
			"com.karasu256.client.ChatNativeClient"
		],
		"modmenu": [
			"com.karasu256.client.config.ChatNativeModMenu"
		]
	},
	"mixins": [
		"chatnative.mixins.json",
		{
			"config": "chatnative.client.mixins.json",
			"environment": "client"
		}
	],
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/client/gui/screens/Screen": [
				"com/karasu256/client/screen/ScreenTracked"
			]
		}
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}