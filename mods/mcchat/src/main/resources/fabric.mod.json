{
	"schemaVersion": 1,
	"id": "chatnative",
	"version": "${version}",
	"name": "ChatNative",
	"description": "Captures chat, command and player events and syncs them to external apps over TCP.",
	"authors": [
		"Karasu-Lab"
	],
	"contact": {
		"homepage": "https://github.com/Karasu-Lab/mcchat",
		"sources": "https://github.com/Karasu-Lab/mcchat"
	},
	"license": "CC0-1.0",
	"icon": "assets/chatnative/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.karasu256.ChatNative"
		],
		"client": [
			"com.karasu256.client.ChatNativeClient"
		]
	},
	"mixins": [
		"chatnative.mixins.json",
		{
			"config": "chatnative.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*"
	}
}